{
  "name": "groupshuffle",
  "productName": "GroupShuffle",
  "version": "1.0.0",
  "description": "随机、平均分组桌面工具，支持 10 万+ 行数据",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check-i18n": "node scripts/check-i18n.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.steven.groupshuffle",
    "productName": "GroupShuffle",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GroupShuffle"
    },
    "portable": {
      "artifactName": "GroupShuffle-${version}-portable.exe"
    }
  }
}
